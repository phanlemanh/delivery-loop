{
  "extraKnownMarketplaces": {
    "delivery-loop": {
      "source": {
        "source": "github",
        "repo": "phanlemanh/delivery-loop"
      }
    }
  },
  "enabledPlugins": {
    "acceptance-gate@delivery-loop": true,
    "feature-loop@delivery-loop": true,
    "dispatch@delivery-loop": true,
    "diagram-design@delivery-loop": true,
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(bash tests/scripts/run-tests.sh --manh bash)",
      "Bash(bash tests/scripts/run-tests.sh --manh mjs:1/3)",
      "Bash(bash tests/scripts/run-tests.sh --manh mjs:2/3)",
      "Bash(bash tests/scripts/run-tests.sh --manh mjs:3/3)",
      "Bash(bash tests/hooks/run-tests.sh)",
      "Bash(bash -c 'set -o pipefail; bash tests/plugins/run-tests.sh --manh vung:1 2>&1 | grep -E \"FAIL|^Results:\" | tail -n 40')",
      "Bash(bash -c 'set -o pipefail; bash tests/plugins/run-tests.sh --manh vung:2 2>&1 | grep -E \"FAIL|^Results:\" | tail -n 40')",
      "Bash(bash -c 'set -o pipefail; bash tests/plugins/run-tests.sh --manh vung:3 2>&1 | grep -E \"FAIL|^Results:\" | tail -n 40')",
      "Bash(bash tests/workflows/run-tests.sh)",
      "Bash(node scripts/product-map.mjs --root . --check)",
      "Bash(node tests/scripts/kiem-ban-cai.ca.mjs --chi-luot-moc)"
    ]
  }
}
